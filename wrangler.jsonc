{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glass-tasks",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glass-tasks",
      "database_id": "295eabbf-1ba8-4a83-b6e1-856411de9b2e",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "GUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "AUTH_MODE": "guest",
    "AI_FEATURES": "off",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GOOGLE_CLIENT_ID": "459128808648-0vecitrfnirmh34oemcqciicd5oasjcq.apps.googleusercontent.com"
  },
  "observability": { "enabled": true },

  // E2E test environment: local D1, mocked Workers AI, mocked Google OAuth server (tests/mock-google.mjs)
  "env": {
    "test": {
      "name": "glass-tasks-test",
      "ratelimits": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glass-tasks-test",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_MODE": "mock",
        "GEMINI_MODEL": "gemini-3.5-flash-lite",
        "GEMINI_API_KEY": "test-gemini-key",
        "GEMINI_API_URL": "http://localhost:9999/gemini",
        "GOOGLE_CLIENT_ID": "test-client",
        "GOOGLE_CLIENT_SECRET": "test-secret",
        "GOOGLE_AUTH_URL": "http://localhost:9999/o/oauth2/v2/auth",
        "GOOGLE_TOKEN_URL": "http://localhost:9999/token",
        "GOOGLE_USERINFO_URL": "http://localhost:9999/v1/userinfo"
      }
    }
  }
}
